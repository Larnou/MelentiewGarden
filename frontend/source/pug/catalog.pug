extends components/template_layout

mixin seedlingsCard(href, dataTags, imageSrc, imageAlt, title, subtitle, price)
  a.seedlings-card(href=href data-tags=dataTags)
    img.seedlings-card__image(src=imageSrc alt=imageAlt)
    h2.seedlings-card__title= title
    p.seedlings-card__subtitle= subtitle
    p.seedlings-card__price= price

append variables
  -
    pageTitle = 'Каталог саженцев'
    pageDescription = 'Полный список саженцев сада Мелентьевых'
    main = { class: 'main--article' }

prepend mainContent

  section.seedlings.seedlings--page
    .seedlings__container
      .seedlings__header
        h1.seedlings__title Каталог саженцев

      .tag-filter.js-tag-filter(data-target=".seedlings-card")
        span.tag-filter__label Фильтровать по типам
        .tag-filter__chips
          button.tag-filter__chip(type="button" data-tag="all" aria-pressed="true") Все
          button.tag-filter__chip(type="button" data-tag="seedling-seed") Семечковые
          button.tag-filter__chip(type="button" data-tag="seedling-stone") Косточковые
          button.tag-filter__chip(type="button" data-tag="seedling-berry") Ягодные
          button.tag-filter__chip(type="button" data-tag="seedling-decor") Декоративные
          button.tag-filter__chip(type="button" data-tag="seedling-indoor") Комнатные

      .seedlings__list.seedlings__list--grid
        // Порядок аргументов миксина: href, dataTags, imageSrc, imageAlt, title, subtitle, price
        +seedlingsCard('seedling-apple-test.html', 'seedling-seed', 'img/apple.webp', 'Яблоня сорт 1', 'ЯБЛОНЯ · сорт 1', '3‑летний саженец', 'от 900 ₽')
        +seedlingsCard('#', 'seedling-seed', 'img/apple.webp', 'Яблоня сорт 2', 'ЯБЛОНЯ · сорт 2', '2‑летний саженец', 'от 800 ₽')
        +seedlingsCard('#', 'seedling-stone', 'img/apple.webp', 'Яблоня сорт 3', 'ЯБЛОНЯ · сорт 3', '1‑летний саженец', 'от 700 ₽')
        +seedlingsCard('#', 'seedling-berry', 'img/apple.webp', 'Яблоня сорт 4', 'ЯБЛОНЯ · сорт 4', '2‑летний саженец', 'от 950 ₽')
        +seedlingsCard('#', 'seedling-decor seedling-indoor', 'img/apple.webp', 'Яблоня сорт 5', 'ЯБЛОНЯ · сорт 5', '3‑летний саженец', 'от 1050 ₽')

