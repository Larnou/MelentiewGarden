extends components/template_layout

append variables
  -
    pageTitle = 'Каталог саженцев'
    pageDescription = 'Полный список саженцев сада Мелентьевых'
    main = { class: 'main--article' }

prepend mainContent

  section.catalog-hero
    .catalog-hero__container
      h1.catalog-hero__title= CATALOG_PAGE.title
      p.catalog-hero__lead= CATALOG_PAGE.lead

      .tag-filter.tag-filter--hero.js-catalog-filter(data-catalog-filter="type" data-target=".seedlings-card")
        span.tag-filter__label= CATALOG_PAGE.filterLabel
        .tag-filter__chips
          each chip, i in CATALOG_FILTER_CHIPS
            button.tag-filter__chip(type="button" data-value=chip.tag aria-pressed=i === 0 ? 'true' : 'false' class=(i === 0 ? 'tag-filter__chip--active' : ''))= chip.label

  section.catalog-perks
    ul.catalog-perks__list
      each perk, i in CATALOG_PAGE.perks
        li.catalog-perks__item
          span.catalog-perks__icon= i + 1
          .catalog-perks__content
            h2.catalog-perks__title= perk.title
            p.catalog-perks__text= perk.text

  section.seedlings.seedlings--page
    .seedlings__container
      .catalog-filters
        .catalog-select.js-catalog-filter(data-catalog-filter="kind" data-placeholder="Культура")
          button.catalog-select__button(type="button" aria-expanded="false" aria-haspopup="listbox" aria-controls="catalog-kind-menu" aria-label="Культура")
            span.catalog-select__value Культура
            span.catalog-select__chevron(aria-hidden="true")
          .catalog-select__menu#catalog-kind-menu(role="listbox" hidden)
            each chip, i in CATALOG_KIND_CHIPS
              button.catalog-select__option(type="button" role="option" data-value=chip.value data-types=chip.types aria-selected=(i === 0 ? 'true' : 'false'))= chip.label

        .catalog-select.js-catalog-filter(data-catalog-filter="season" data-placeholder="Срок созревания")
          button.catalog-select__button(type="button" aria-expanded="false" aria-haspopup="listbox" aria-controls="catalog-season-menu" aria-label="Срок созревания")
            span.catalog-select__value Срок созревания
            span.catalog-select__chevron(aria-hidden="true")
          .catalog-select__menu#catalog-season-menu(role="listbox" hidden)
            each chip, i in CATALOG_SEASON_CHIPS
              button.catalog-select__option(type="button" role="option" data-value=chip.value aria-selected=(i === 0 ? 'true' : 'false'))= chip.label

      p.catalog-empty.js-catalog-empty(hidden) Таких саженцев пока нет

      .seedlings__list.seedlings__list--grid
        each item in CATALOG_ITEMS
          +seedlingsCard(item, 'h2')

