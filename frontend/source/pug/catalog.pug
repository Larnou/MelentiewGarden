extends components/template_layout

mixin seedlingsCard(href, dataTags, imageSrc, imageAlt, title, subtitle, price)
  a.seedlings-card(href=href data-tags=dataTags)
    img.seedlings-card__image(src=imageSrc alt=imageAlt)
    h2.seedlings-card__title= title
    p.seedlings-card__subtitle= subtitle
    p.seedlings-card__price= price

append variables
  -
    pageTitle = 'Каталог саженцев'
    pageDescription = 'Полный список саженцев сада Мелентьевых'
    main = { class: 'main--article' }

prepend mainContent

  section.seedlings.seedlings--page
    .seedlings__container
      .seedlings__header
        h1.seedlings__title= CATALOG_PAGE.title

      .tag-filter.js-tag-filter(data-target=".seedlings-card")
        span.tag-filter__label= CATALOG_PAGE.filterLabel
        .tag-filter__chips
          each chip, i in CATALOG_FILTER_CHIPS
            button.tag-filter__chip(type="button" data-tag=chip.tag aria-pressed=i === 0 ? 'true' : 'false' class=(i === 0 ? 'tag-filter__chip--active' : ''))= chip.label

      .seedlings__list.seedlings__list--grid
        each item in CATALOG_ITEMS
          +seedlingsCard(item.href, item.dataTags, item.imageSrc, item.imageAlt, item.title, item.subtitle, item.price)

