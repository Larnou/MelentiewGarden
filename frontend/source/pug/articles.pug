extends components/template_layout

append variables
  -
    pageTitle = 'Статьи сада Мелентьевых'
    pageDescription = 'Подборка статей о посадке, уходе и подготовке сада к зиме'
    main = { class: 'main--article' }

prepend mainContent

  section.articles-hero
    .articles-hero__container
      h1.articles-hero__title= ARTICLES_PAGE.title
      p.articles-hero__lead= ARTICLES_PAGE.subtitle

      .tag-filter.tag-filter--hero.js-tag-filter(data-target=".articles--page .article-card")
        span.tag-filter__label= ARTICLES_PAGE.filterLabel
        .tag-filter__chips
          each chip, i in ARTICLES_FILTER_CHIPS
            button.tag-filter__chip(type="button" data-tag=chip.tag aria-pressed=i === 0 ? 'true' : 'false' class=(i === 0 ? 'tag-filter__chip--active' : ''))= chip.label

  section.articles.articles--page
    .articles__container
      .articles__list.articles__list--grid
        each item in ARTICLES_ITEMS
          +articleCard(item, 'h2')

