extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Манарага'
    pageDescription = 'Зимний сорт яблони Манарага: крупные плоды до 120–150 г, колоновидное дерево до 2 м, длительное хранение. Уральская селекция.'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Манарага

      +articleBlockHeadingText('Характеристики')
      +articleBlockListUnordered()
        li Зимний сорт.
        li Плоды крупные, массой до 120–150 г, с ярко-красным румянцем, хорошего вкуса. Мякоть сочная.
        li Созревают в сентябре, пригодны для длительного хранения.
        li Дерево колоновидное, компактное, высотой до 2 м.
        li Для своей группы зимостойкий, но требует более тёплого места и укрытия в особо суровые зимы.

      +articleBlockText()
        p
          | Уральская селекция.

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/manaraga/mg1.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/manaraga/mg2.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/manaraga/mg3.jpg' alt="")
          p.article-block__slide-caption
