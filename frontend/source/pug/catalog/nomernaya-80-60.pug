extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Номерная 80-60'
    pageDescription = 'Зимний сорт яблони Номерная 80-60: плоды 60–90 г, хранение до марта, урожайность и зимостойкость. Селекция Т.Ф. Корниенко (Барнаул).'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Номерная 80-60

      +articleBlockHeadingText('Характеристики')
      +articleBlockListUnordered()
        li Зимний сорт.
        li Плоды массой 60–90 г, округлые, зелёно-жёлтые с размытым малиново-красным румянцем, хорошего кисло-сладкого вкуса. Мякоть белая, сочная, крупнозернистая.
        li Созревают в сентябре, в лежке плоды набирают вкус. Хранятся до марта.
        li Дерево среднерослое, с округлой кроной.
        li Сорт урожайный, зимостойкий, рано вступает в плодоношение.

      +articleBlockText()
        p
          | Селекция Т.Ф. Корниенко (Барнаул).

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/nomernaya-80-60/n81.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/nomernaya-80-60/n82.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/nomernaya-80-60/n83.jpg' alt="")
          p.article-block__slide-caption
