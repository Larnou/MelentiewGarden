extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Маковецкого'
    pageDescription = 'Сорт яблони Маковецкого: розовое цветение в конце мая, мелкие плоды, декоративность круглый год, зимостойкость. Иркутская область.'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Маковецкого

      +articleBlockHeadingText('Характеристики')
      +articleBlockListUnordered()
        li Цветение розовое, обильное, в конце мая.
        li Плоды мелкие, около 10 г, сначала бордовые, к сентябрю становятся оранжевыми. В условиях Иркутской области не всегда успевают полностью вызреть.
        li Дерево высокое, поддаётся формировке.
        li Сорт зимостойкий, цветёт и плодоносит ежегодно. Декоративен в течение всего сезона: весной — за счёт цветения, летом и осенью — благодаря окраске плодов и листвы.

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/makovetskogo/mk1.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/makovetskogo/mk2.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/makovetskogo/mk3.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/makovetskogo/mk4.jpg' alt="")
          p.article-block__slide-caption
