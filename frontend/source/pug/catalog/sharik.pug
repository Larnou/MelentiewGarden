extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Шарик'
    pageDescription = 'Летний сорт яблони Шарик: плоды 40–60 г с румянцем, кисло-сладкий вкус, плодоношение со 2–3 года, зимостойкость. Селекция Т.Ф. Корниенко (Барнаул).'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Шарик

      +articleBlockHeadingText('Характеристики')
      +articleBlockListUnordered()
        li Летний сорт.
        li Плоды массой 40–60 г, яркие, с румянцем, хорошего кисло-сладкого вкуса. Мякоть сочная.
        li Созревают в конце августа.
        li Дерево среднерослое.
        li Плодоносит на 2–3 год, урожайный, зимостойкий.

      +articleBlockText()
        p
          | Селекция Т.Ф. Корниенко (Барнаул).

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/sharik/s1.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/sharik/s2.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/sharik/s3.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/sharik/s4.jpg' alt="")
          p.article-block__slide-caption
