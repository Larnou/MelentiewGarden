extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Подарок садоводам'
    pageDescription = 'Осенний сорт яблони Подарок садоводам: плоды до 80 г, жёлтые с красным штриховым румянцем, зимостойкость, селекция Т.Ф. Корниенко (Барнаул).'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Подарок садоводам

      +articleBlockHeadingText('Характеристики')
      +articleBlockListUnordered()
        li Плоды крупные, массой до 80 г, жёлтые с красным штриховым румянцем. Мякоть сочная, мелкозернистая.
        li Созревают в середине сентября, хранятся до января.
        li Дерево среднерослое.
        li Сорт зимостойкий, плодоносит ежегодно.

      +articleBlockText()
        p
          | Селекция Т.Ф. Корниенко (Барнаул).

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/podarok-sadovodam/ps-1.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/podarok-sadovodam/ps-2.jpg' alt="Вид на сад")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/podarok-sadovodam/ps-3.jpg' alt="Плоды")
          p.article-block__slide-caption
