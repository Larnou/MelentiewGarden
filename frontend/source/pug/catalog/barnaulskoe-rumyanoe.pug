extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Барнаульское румяное'
    pageDescription = 'Поздне-летний сорт яблони Барнаульское румяное: плоды 60–80 г с ярким румянцем, урожайность, нормировка завязей. Алтайская селекция, Барнаул.'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Барнаульское румяное

      +articleBlockHeadingText('Характеристики')
      +productSpecs()
        +productSpec('season', 'Сезон')
          | Поздне-летний сорт.
        +productSpec('fruit', 'Плоды')
          | Массой 60–80 г, красивые, с ярким румянцем, хорошего вкуса. Мякоть сочная.
        +productSpec('calendar', 'Созревание')
          | Созревают в конце августа — начале сентября.
        +productSpec('tree', 'Дерево')
          | Компактное.
        +productSpec('shield', 'Устойчивость')
          | Сорт очень урожайный, требует нормировки завязей. Зимостойкий.

      +articleBlockText()
        p
          | Алтайская селекция (НИИ садоводства Сибири им. М.А. Лисавенко, Барнаул).

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/barnaulskoe-rumyanoe/br1.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/barnaulskoe-rumyanoe/br2.jpg' alt="Вид на сад")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/barnaulskoe-rumyanoe/br3.jpg' alt="Плоды")
          p.article-block__slide-caption
