extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Ермолаева-23'
    pageDescription = 'Летний сорт яблони Ермолаева-23: плоды 25–30 г, созревание в конце августа, высокая урожайность и зимостойкость.'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Ермолаева-23

      +articleBlockHeadingText('Характеристики')
      +articleBlockListUnordered()
        li Летний сорт.
        li Плоды массой 25–30 г, жёлтые с красным румянцем, хорошего вкуса. Мякоть сочная.
        li Созревают в конце августа.
        li Дерево среднерослое.
        li Сорт зимостойкий, очень урожайный.

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/ermolaeva-23/er1.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/ermolaeva-23/er2.jpg' alt="")
          p.article-block__slide-caption
