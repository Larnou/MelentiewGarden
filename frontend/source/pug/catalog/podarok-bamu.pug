extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Подарок БАМу'
    pageDescription = 'Летний сорт яблони Подарок БАМу: плоды до 25 г, тёмно-бордовые, сладкий вкус, невысокое дерево, высокая урожайность и зимостойкость.'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Подарок БАМу

      +articleBlockHeadingText('Характеристики')
      +articleBlockListUnordered()
        li Летний сорт.
        li Плоды массой до 25 г, тёмно-бордовые, сладкого вкуса, почти без кислоты. Мякоть сочная.
        li Созревают во второй половине августа.
        li Дерево невысокое.
        li Сорт зимостойкий, очень урожайный.

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/podarok-bamu/pb1.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/podarok-bamu/pb2.jpg' alt="")
          p.article-block__slide-caption
