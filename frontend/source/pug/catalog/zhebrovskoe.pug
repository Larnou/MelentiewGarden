extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Жебровское'
    pageDescription = 'Ранне-осенний сорт яблони Жебровское: плоды 35–45 г, медовый вкус, урожайность и зимостойкость.'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Жебровское

      +articleBlockHeadingText('Характеристики')
      +articleBlockListUnordered()
        li Ранне-осенний сорт.
        li Плоды массой 35–45 г, жёлтые с ярким румянцем, сладкого, медового вкуса. Мякоть сочная, не крахмалится.
        li Созревают в конце августа — начале сентября.
        li Дерево среднерослое.
        li Сорт зимостойкий, урожайный, плодоносит ежегодно.

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/zhebrovskoe/zh1.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/zhebrovskoe/zh2.jpg' alt="")
          p.article-block__slide-caption
