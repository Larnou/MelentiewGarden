extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Юнга'
    pageDescription = 'Поздне-летний сорт яблони Юнга: плоды 55–70 г, кисло-сладкий вкус, зимостойкость, устойчивость к парше. Алтайская селекция, Барнаул.'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Юнга

      +articleBlockHeadingText('Характеристики')
      +productSpecs()
        +productSpec('season', 'Сезон')
          | Поздне-летний сорт.
        +productSpec('fruit', 'Плоды')
          | Массой 55–70 г, светлые, хорошего кисло-сладкого вкуса. Мякоть средней плотности, очень сочная.
        +productSpec('calendar', 'Созревание')
          | Созревают во второй половине августа, хранятся до 1–1,5 месяцев.
        +productSpec('tree', 'Дерево')
          | Среднерослое, компактное.
        +productSpec('shield', 'Устойчивость')
          | Плодоносит ежегодно, вступает в плодоношение на 3–4 год. Сорт зимостойкий, устойчив к парше.

      +articleBlockText()
        p
          | Алтайская селекция (НИИ садоводства Сибири им. М.А. Лисавенко, Барнаул).

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/yunga/u1.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/yunga/u2.jpg' alt="")
          p.article-block__slide-caption
