extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Алтайское румяное'
    pageDescription = 'Летний сорт яблони Алтайское румяное: плоды 50–80 г с оранжево-красным румянцем, созревание в конце августа, урожайность и зимостойкость. Селекция Т.Ф. Корниенко (Барнаул).'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Алтайское румяное

      +articleBlockHeadingText('Характеристики')
      +articleBlockListUnordered()
        li Летний сорт.
        li Плоды массой 50–80 г, очень красивые, жёлтые с ярким оранжево-красным румянцем, хорошего вкуса. Мякоть сочная.
        li Созревают в конце августа, лучше снимать своевременно.
        li Дерево среднерослое.
        li Сорт очень урожайный, плодоносит ежегодно, зимостойкий.

      +articleBlockText()
        p
          | Селекция Т.Ф. Корниенко (Барнаул).

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/altayskoye-rumyanoe/ar1.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/altayskoye-rumyanoe/ar2.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/altayskoye-rumyanoe/ar3.jpg' alt="")
          p.article-block__slide-caption
