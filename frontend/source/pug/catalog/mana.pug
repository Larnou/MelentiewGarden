extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Мана'
    pageDescription = 'Летний сорт яблони Мана: плоды 40–45 г, ярко-жёлтые с румянцем, низкое компактное дерево, высокая урожайность, зимостойкость.'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Мана

      +articleBlockHeadingText('Характеристики')
      +articleBlockListUnordered()
        li Летний сорт.
        li Плоды массой 40–45 г, ярко-жёлтые с румянцем, хорошего вкуса. Мякоть сочная.
        li Созревают в августе.
        li Дерево невысокое, компактное, с поникающими ветками.
        li Сорт отличается очень высокой урожайностью, плодоносит ежегодно, вступает в плодоношение на 3-й год. Зимостойкий.

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/mana/m1.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/mana/m2.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/mana/m3.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/mana/m4.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/mana/m5.jpg' alt="")
          p.article-block__slide-caption
