extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Малиновка'
    pageDescription = 'Осенний сорт яблони Малиновка: плоды 120–150 г, стланцевая форма, скороплодность, укрытие на зиму.'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Малиновка

      +articleBlockHeadingText('Характеристики')
      +productSpecs()
        +productSpec('season', 'Сезон')
          | Осенний сорт.
        +productSpec('fruit', 'Плоды')
          | Крупные, массой 120–150 г, жёлтые с румянцем, хорошего вкуса. Мякоть сочная.
        +productSpec('calendar', 'Созревание')
          | Созревают в начале сентября, хранятся до декабря.
        +productSpec('tree', 'Дерево')
          | Невысокое, так как необходимо формировать его в стланцевой форме.
        +productSpec('shield', 'Устойчивость')
          | Сорт скороплодный, урожайный, зимует под укрытием.

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/malinovka/ml1.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/malinovka/ml2.jpg' alt="")
          p.article-block__slide-caption
