extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Синапчик'
    pageDescription = 'Осенний сорт яблони Синапчик: плоды 60–80 г бочонком, сладкая сочная мякоть, низкорослое дерево, зимостойкость. Селекция Т.Ф. Корниенко (Барнаул).'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Синапчик

      +articleBlockHeadingText('Характеристики')
      +articleBlockListUnordered()
        li Осенний сорт.
        li Плоды массой 60–80 г, красивой формы, бочонком, хорошего вкуса. Мякоть плотная, очень сочная, сладкая.
        li Созревают в сентябре.
        li Дерево низкорослое, растёт медленно, компактное.
        li Сорт урожайный, зимостойкий.

      +articleBlockText()
        p
          | Селекция Т.Ф. Корниенко (Барнаул).

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/sinapchik/s1.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/sinapchik/s2.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/sinapchik/s3.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/sinapchik/s4.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/sinapchik/s5.jpg' alt="")
          p.article-block__slide-caption
