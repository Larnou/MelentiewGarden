extends ../components/template_layout

append variables
  -
    pageTitle = 'Яблоня · Свердловчанин'
    pageDescription = 'Зимний сорт яблони Свердловчанин: плоды 100–130 г, хранение до марта, стланцевая форма, укрытие на зиму.'
    main = { class: 'main--article' }

prepend mainContent

  section.article.article--product
    .article__container
      a.article__back(href="../catalog.html") ← Назад к каталогу

      h1.article__title Яблоня · Свердловчанин

      +articleBlockHeadingText('Характеристики')
      +productSpecs()
        +productSpec('season', 'Сезон')
          | Зимний сорт.
        +productSpec('fruit', 'Плоды')
          | Массой 100–130 г, зеленовато-жёлтые, хорошего вкуса. Мякоть плотная, мелкозернистая, сочная.
        +productSpec('calendar', 'Созревание')
          | Созревают в начале сентября, пригодны для длительного хранения — до марта.
        +productSpec('tree', 'Дерево')
          | Невысокое, так как необходимо формировать его в стланцевой форме.
        +productSpec('shield', 'Устойчивость')
          | Сорт урожайный, зимует под укрытием.

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/sverdlovchanin/sv1.jpg' alt="")
          p.article-block__slide-caption
        .article-block__slide.swiper-slide
          img(src='img/pages/catalog/sverdlovchanin/sv2.jpg' alt="")
          p.article-block__slide-caption
