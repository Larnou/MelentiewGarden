// Блок "История нашего сада"
mixin history()
  section.history(id="about")
    .history__container
      h2.history__title История нашего сада

      .history__content
        .history__image-wrapper
          img.history__image(src="img/field.webp" alt="Вид на сад")

        .history__text
          p.history__paragraph
            | Тут будет текст о том, как Людмила
            |  Михайловна организовала сад, об опыте
            |  и экспериментах в поисках самых вкусных
            |  и надёжных сортов.

