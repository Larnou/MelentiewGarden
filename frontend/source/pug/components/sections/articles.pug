// Блок "Статьи" с карточками и стрелками
mixin articles()
  section.articles(id="articles")
    .articles__container
      .articles__header
        h2.articles__title Статьи

      .articles__slider.swiper.js--articles-slider
        .articles__list.swiper-wrapper
          a.article-card.swiper-slide(href="article-apples.html")
            img.article-card__image(src="img/apple.webp" alt="Как сажать яблоню?")
            h3.article-card__title Как сажать яблоню?
            p.article-card__meta Советы по подготовке почвы и уходу

          a.article-card.swiper-slide(href="#")
            img.article-card__image(src="img/apple.webp" alt="Как ухаживать за яблоней?")
            h3.article-card__title Как ухаживать за яблоней?
            p.article-card__meta Основные этапы ухода в течение сезона

          a.article-card.swiper-slide(href="#")
            img.article-card__image(src="img/apple.webp" alt="Как обрезать яблоню?")
            h3.article-card__title Как обрезать яблоню?
            p.article-card__meta Основные принципы формирующей обрезки

          a.article-card.swiper-slide(href="#")
            img.article-card__image(src="img/apple.webp" alt="Как подготовить сад к зиме?")
            h3.article-card__title Как подготовить сад к зиме?
            p.article-card__meta Что сделать осенью, чтобы деревья хорошо перезимовали

          a.article-card.swiper-slide(href="#")
            img.article-card__image(src="img/apple.webp" alt="Как выбрать сорт яблони?")
            h3.article-card__title Как выбрать сорт яблони?
            p.article-card__meta Ориентиры при выборе сортов для Сибири

      .articles__controls
        button.articles__arrow.articles__arrow--prev(type="button" aria-label="Предыдущие статьи")
          span ◀

        a.articles__more-button(href="articles.html") Посмотреть больше

        button.articles__arrow.articles__arrow--next(type="button" aria-label="Следующие статьи")
          span ▶

