// Блок "Статьи" с карточками и стрелками
mixin articles()
  section.articles(id="articles")
    .articles__container
      .articles__header
        h2.articles__title Статьи

      .articles__slider.swiper.js-articles-slider
        .articles__list.swiper-wrapper
          each item in ARTICLES_ITEMS
            a.article-card.swiper-slide(href=item.href data-tags=item.dataTags)
              img.article-card__image(src=item.imageSrc alt=item.imageAlt)
              h3.article-card__title= item.title
              p.article-card__meta= item.meta

      .articles__controls
        button.articles__arrow.articles__arrow--prev(type="button" aria-label="Предыдущие статьи")
          span ◀

        a.articles__more-button(href="articles.html") Посмотреть больше

        button.articles__arrow.articles__arrow--next(type="button" aria-label="Следующие статьи")
          span ▶

