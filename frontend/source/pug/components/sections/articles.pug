// Карточка статьи: страница статей (h2).
mixin articleCard(item, heading)
  - const Tag = heading || 'h2'
  - const topicTags = (item.dataTags || '').split(/\s+/).filter((tag) => ARTICLE_TOPIC_LABELS[tag])
  a.article-card(href=item.href data-tags=item.dataTags)&attributes(attributes)
    img.article-card__image(src=item.imageSrc alt=item.imageAlt)
    #{Tag}.article-card__title= item.title
    if topicTags.length
      p.article-card__topics
        each tag in topicTags
          span.article-card__topic= ARTICLE_TOPIC_LABELS[tag]
    p.article-card__meta= item.meta

// Баннер статей на главной: текст слева, фото справа, ссылка на все статьи.
mixin articles()
  section.articles(id="articles")
    .articles__container
      .articles__promo
        .articles__promo-content
          h2.articles__promo-title Полезные статьи о саде и растениях
          p.articles__promo-lead Советы по посадке, уходу, защите растений и выбору сортов от наших специалистов.
          a.btn.btn--primary.articles__promo-button(href="articles.html")
            | Читать статьи
            svg.btn__icon(width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true")
              path(d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round")
