// Блок "Наши преимущества"
mixin advantages()
  section.advantages
    .advantages__container
      h2.advantages__title Наши преимущества

      .advantages__tags
        button.advantages__tag(type="button") Надёжность
        button.advantages__tag(type="button") Все саженцы — проверены
        button.advantages__tag(type="button") Гарантия

