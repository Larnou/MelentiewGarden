// Карточка саженца: каталог (h2) и сетка на главной (h3).
mixin seedlingsCard(item, heading)
  - const Tag = heading || 'h2'
  -
    const kindSlug = {
      'Яблоня': 'apple',
      'Груша': 'pear',
      'Вишня': 'cherry',
      'Слива': 'plum',
      'Земляника': 'strawberry',
      'Жимолость': 'honeysuckle',
      'Малина': 'raspberry',
      'Крыжовник': 'gooseberry',
      'Смородина': 'currant',
    }[item.kind] || ''
  a.seedlings-card(href=item.href data-tags=item.dataTags data-kind=kindSlug data-season=item.season)&attributes(attributes)
    img.seedlings-card__image(src=item.imageSrc alt=item.imageAlt)
    #{Tag}.seedlings-card__variety= item.variety
    p.seedlings-card__meta
      span.seedlings-card__kind= item.kind
      span.seedlings-card__season(class='seedlings-card__season--' + item.season)= item.seasonLabel

// Блок "Саженцы" на главной: заголовок слева, CTA справа, сетка карточек.
mixin seedlings()
  section.seedlings(id="catalog")
    .seedlings__container
      .seedlings__header
        .seedlings__intro
          h2.seedlings__title Саженцы
          p.seedlings__subtitle Выбирайте из проверенных сортов
        a.btn.btn--outline.seedlings__all(href="catalog.html")
          | Все сорта
          svg.btn__icon(width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true")
            path(d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round")

      .seedlings__list.seedlings__list--grid
        each item in MAIN_PAGE_CATALOG_ITEMS
          +seedlingsCard(item, 'h3')
