// Блок "Ближайшая ярмарка"
mixin fair()
  section.fair(id="news")
    .fair__container
      .fair__label Ярмарки саженцев
      .fair__card
        .fair__image-wrapper
          img.fair__image(src="img/news/news_banner.jpg" alt="Фотографии ярмарок")

        .fair__slider.swiper.js--fair-slider
          .fair__list.swiper-wrapper

            .fair__content.swiper-slide
              h3.fair__title Музей-усадьба В.П. Сукачева
              p.fair__date даты уточняются
              p.fair__description
                | ул. Декабрьских Событий 112, около танка

            .fair__content.swiper-slide
              h3.fair__title Остановка Волжская
              p.fair__date даты уточняются
              p.fair__description
                | ул. Волжская 14Б, рядом с рынком "Волжский"

            .fair__content.swiper-slide
              h3.fair__title СибЭкспоЦентр
              p.fair__date 21–23 августа · 10:00–18:00
              p.fair__description
                | ул. Байкальская 253А, около 3-го павильона
