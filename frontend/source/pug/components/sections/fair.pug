// Блок "Ближайшая ярмарка": одно фото и слайдер объявлений
mixin fair()
  section.fair(id="news")
    .fair__container
      h2.fair__label Ярмарки саженцев
      .fair__card
        .fair__image-wrapper
          img.fair__image(src="img/pages/exposition_banner.jpg" alt="Фотографии ярмарок")

        .fair__slider.swiper.js-fair-slider
          .fair__list.swiper-wrapper
            .fair__content.swiper-slide
              .fair__head
                p.fair__eyebrow Ближайшая ярмарка
                p.fair__date Май, сентябрь
              h3.fair__title Музей-усадьба В.П. Сукачева
              p.fair__place
                svg.fair__pin(width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true")
                  path(d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" stroke="currentColor" stroke-width="1.6")
                  circle(cx="12" cy="10" r="2.2" stroke="currentColor" stroke-width="1.6")
                span г. Иркутск, ул. Декабрьских Событий, 112, около танка
              a.link.link--arrow.fair__route(href="https://yandex.ru/maps/?text=Иркутск%2C%20улица%20Декабрьских%20Событий%20112" target="_blank" rel="noopener noreferrer")
                | Как пройти
                svg.btn__icon(width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true")
                  path(d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round")

            .fair__content.swiper-slide
              .fair__head
                p.fair__eyebrow Ближайшая ярмарка
                p.fair__date Май, август, сентябрь
              h3.fair__title Остановка Волжская
              p.fair__place
                svg.fair__pin(width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true")
                  path(d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" stroke="currentColor" stroke-width="1.6")
                  circle(cx="12" cy="10" r="2.2" stroke="currentColor" stroke-width="1.6")
                span г. Иркутск, ул. Волжская, 14Б, рядом с рынком «Волжский»
              a.link.link--arrow.fair__route(href="https://yandex.ru/maps/?text=Иркутск%2C%20улица%20Волжская%2014Б" target="_blank" rel="noopener noreferrer")
                | Как пройти
                svg.btn__icon(width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true")
                  path(d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round")

            .fair__content.swiper-slide
              .fair__head
                p.fair__eyebrow Ближайшая ярмарка
                p.fair__date 20–22 августа, 10:00–17:00
              h3.fair__title СибЭкспоЦентр
              p.fair__place
                svg.fair__pin(width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true")
                  path(d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" stroke="currentColor" stroke-width="1.6")
                  circle(cx="12" cy="10" r="2.2" stroke="currentColor" stroke-width="1.6")
                span г. Иркутск, ул. Байкальская, 253А, около 3-го павильона
              a.link.link--arrow.fair__route(href="https://yandex.ru/maps/?text=Иркутск%2C%20улица%20Байкальская%20253А" target="_blank" rel="noopener noreferrer")
                | Как пройти
                svg.btn__icon(width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true")
                  path(d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round")

          .fair__dots
