//- Блоки-шаблоны для контента статей (конструктор страницы)
//- Использование: на странице статьи в .article__container после заголовка вызывать миксины и передавать контент в block.

//- Текст (один или несколько абзацев)
mixin articleBlockText()
  .article-block.article-block--text
    .article-block__content
      block

//- Текст с заголовком (заголовок + абзацы; block опционален)
mixin articleBlockHeadingText(title)
  .article-block.article-block--heading-text
    h2.article-block__heading= title
    if block
      .article-block__content
        block

//- Нумерованный список
mixin articleBlockListOrdered()
  .article-block.article-block--list.article-block--list-ordered
    ol.article-block__list
      block

//- Маркированный список
mixin articleBlockListUnordered()
  .article-block.article-block--list.article-block--list-unordered
    ul.article-block__list
      block

//- Текст с картинкой слева (картинка слева, текст справа)
mixin articleBlockMediaLeft(src, alt)
  .article-block.article-block--media.article-block--media-left
    .article-block__media-image
      img(src=src alt=alt)
    .article-block__media-text
      block

//- Текст с картинкой справа (текст слева, картинка справа)
mixin articleBlockMediaRight(src, alt)
  .article-block.article-block--media.article-block--media-right
    .article-block__media-text
      block
    .article-block__media-image
      img(src=src alt=alt)

//- Слайдер картинок (только изображения). В block — элементы .article-block__slide с img внутри
mixin articleBlockSlider()
  .article-block.article-block--slider
    .article-block__slider.swiper.js-article-gallery
      .article-block__slider-wrapper.swiper-wrapper
        block
    .article-block__slider-controls
      button.article-block__arrow.article-block__arrow--prev(type="button" aria-label="Назад")
        span ◀
      button.article-block__arrow.article-block__arrow--next(type="button" aria-label="Вперёд")
        span ▶

//- Характеристики саженца: иконка, подпись и текст. В block — вызовы +productSpec
mixin productSpecs()
  .article-block.article-block--specs
    ul.product-specs
      block

//- Одна характеристика. icon — fruit, calendar, tree, shield, season
mixin productSpec(icon, title)
  li.product-specs__item
    span.product-specs__icon
      case icon
        when 'fruit'
          svg(width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true")
            path(d="M12 7.2c-2.8.2-5.5 2.4-5.5 6.3 0 3.6 2.3 6 5.5 6s5.5-2.4 5.5-6c0-3.9-2.7-6.1-5.5-6.3Z" stroke="currentColor" stroke-width="1.6")
            path(d="M12 7.2c.2-1.8 1.3-3.2 3-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round")
            path(d="M12 7.5c-.5-1.3-1.7-2.2-3-2.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round")
        when 'calendar'
          svg(width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true")
            rect(x="3.5" y="5" width="17" height="15.5" rx="2" stroke="currentColor" stroke-width="1.6")
            path(d="M3.5 9.5h17M8 3.2v3.2M16 3.2v3.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round")
        when 'tree'
          svg(width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true")
            path(d="M12 20.6V15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round")
            path(d="M9.2 20.6h5.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round")
            path(d="M12 15.2c-3.4 0-5.7-2.1-5.7-4.8 0-2.8 2.5-5 5.7-5s5.7 2.2 5.7 5c0 2.7-2.3 4.8-5.7 4.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round")
        when 'shield'
          svg(width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true")
            path(d="M12 3.5 5.5 6.2v5.4c0 4.1 2.7 7.2 6.5 8.9 3.8-1.7 6.5-4.8 6.5-8.9V6.2L12 3.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round")
            path(d="M8.8 12.1 11 14.2l4.2-4.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round")
        when 'season'
          svg(width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true")
            circle(cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.6")
            path(d="M12 3.5v2.2M12 18.3v2.2M3.5 12h2.2M18.3 12h2.2M6 6l1.6 1.6M16.4 16.4 18 18M18 6l-1.6 1.6M7.6 16.4 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round")
        default
          +svg(icon, 24, 24)
    span.product-specs__body
      span.product-specs__title= title
      span.product-specs__text
        block

//- Слайдер картинок с подписью под каждым изображением. В block — элементы .article-block__slide: img + .article-block__slide-caption
mixin articleBlockSliderCaptions()
  .article-block.article-block--slider-captions
    .article-block__slider.swiper.js-article-gallery-captions
      .article-block__slider-wrapper.swiper-wrapper
        block
    .article-block__slider-controls
      button.article-block__arrow.article-block__arrow--prev(type="button" aria-label="Назад")
        span ◀
      button.article-block__arrow.article-block__arrow--next(type="button" aria-label="Вперёд")
        span ▶
