mixin hero()
  section.hero(style="--hero-bg: url('/img/background.png')")
    .hero__overlay
    .hero__container
      .hero__content
        h2.hero__title Сад Мелентьевых
        p.hero__subtitle
          | Мы выращиваем только проверенные урожайные сорта
          br
          | адаптированные к сибирским морозам

        .hero__slider.swiper.js--hero-categories
          //- Additional required wrapper
          .hero__slider-container.swiper-wrapper
            //- Slides
            a(href='#').hero__slider-slide.swiper-slide Семечковые
            a(href='#').hero__slider-slide.swiper-slide Косточковые
            a(href='#').hero__slider-slide.swiper-slide Ягодные
            a(href='#').hero__slider-slide.swiper-slide Декоративные
            a(href='#').hero__slider-slide.swiper-slide Комнатные


    //.hero__bottom
    //  .hero__bottom-card
    //    span.hero__bottom-title Ближайшая ярмарка
