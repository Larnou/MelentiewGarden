mixin hero()
  section.hero(style="--hero-bg: url('img/background.webp')")
    .hero__overlay
    .hero__container
      .hero__content
        h1.hero__title Сад Мелентьевых
        p.hero__subtitle
          | Мы выращиваем только проверенные урожайные сорта
          br
          | адаптированные к сибирским морозам

        .hero__slider.swiper.js-hero-categories
          //- Additional required wrapper
          .hero__slider-container.swiper-wrapper
            //- Slides
            a.hero__slider-slide.swiper-slide(href="catalog.html?tag=seedling-seed") Семечковые
            a.hero__slider-slide.swiper-slide(href="catalog.html?tag=seedling-stone") Косточковые
            a.hero__slider-slide.swiper-slide(href="catalog.html?tag=seedling-berry") Ягодные
            a.hero__slider-slide.swiper-slide(href="catalog.html?tag=seedling-decor") Декоративные
            a.hero__slider-slide.swiper-slide(href="catalog.html?tag=seedling-indoor") Комнатные
