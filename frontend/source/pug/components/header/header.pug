//- Используемые переменные, относящиеся к Header
    header.class    - дополнительный класс (js-class)

mixin header()
  header.header(class=header && header.class ? header.class : '')
    .header__container
      a.header__logo(href="/")
        +svg('apple', 40, 40)
        h1.header__title САЖЕНЦЫ-ИРКУТСК

      nav.header__nav(aria-label="Главное меню")
        ul.header__menu
          li.header__item: a.header__link(href="/news") Новости
          li.header__item: a.header__link(href="/catalog") Каталог
          li.header__item: a.header__link(href="/articles") Статьи
          li.header__item: a.header__link(href="/about") О нас

