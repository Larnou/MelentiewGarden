//- Используемые переменные, относящиеся к Header
    header.class    - дополнительный класс (js-class)

mixin header()
  header.header(class=header && header.class ? header.class : '')
    .header__container
      a.header__logo(
        href="/"
        target=header && header.isMain ? false : "_blank"
        rel=header && header.isMain ? false : "noopener noreferrer"
      )
        .header__logo-icon
          +svg('apple', 40, 40)

        h1.header__title САЖЕНЦЫ-ИРКУТСК


      button.header__burger(type="button" aria-label="Меню" aria-controls="site-nav" aria-expanded="false")
        span

      nav.header__nav(aria-label="Главное меню")
        ul.header__menu
          li.header__item
            a.header__link(
              href=header && header.isMain ? "#news" : "index.html#news"
              target=header && header.isMain ? false : "_blank"
              rel=header && header.isMain ? false : "noopener noreferrer"
            ) Новости
          li.header__item
            a.header__link(
              href=header && header.isMain ? "#catalog" : "index.html#catalog"
              target=header && header.isMain ? false : "_blank"
              rel=header && header.isMain ? false : "noopener noreferrer"
            ) Каталог
          li.header__item
            a.header__link(
              href=header && header.isMain ? "#articles" : "index.html#articles"
              target=header && header.isMain ? false : "_blank"
              rel=header && header.isMain ? false : "noopener noreferrer"
            ) Статьи
          li.header__item
            a.header__link(
              href=header && header.isMain ? "#about" : "index.html#about"
              target=header && header.isMain ? false : "_blank"
              rel=header && header.isMain ? false : "noopener noreferrer"
            ) О нас

