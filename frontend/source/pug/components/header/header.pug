//- Используемые переменные, относящиеся к Header
    header.class    - дополнительный класс (js-class)

mixin header()
  header.header(class=header && header.class ? header.class: '')
    .header__container
      a.header__logo(href=SITE.homeHref)
        .header__logo-icon
          +svg('apple', 40, 40)

        h1.header__title= SITE.brandName


      button.header__burger(type="button" aria-label="Меню" aria-controls="site-nav" aria-expanded="false")
        span

      nav.header__nav(id="site-nav" aria-label="Главное меню")
        ul.header__menu
          each item in SITE.nav
            li.header__item
              a.header__link(href=header && header.isMain ? item.mainHref : item.otherHref)= item.label

