//- Используемые переменные, относящиеся к Footer
    footer.class    - дополнительный класс (js--class) или другие

mixin footer()
  footer(class='footer' + (footer.class === null ? '' : ' ' + footer.class))
    .footer__container
      //- Ссылка и адрес
      .footer__brand
        a.footer__logo.footer__logo--address(href="#")
          .footer__logo-icon
            +svg('apple', 40, 40)
          .footer__title САЖЕНЦЫ-ИРКУТСК


        p.footer__address р.п. Марково, Ново-Иркутский

      //- Контакты
      .footer__contacts
        .footer__section-title НАШИ КОНТАКТЫ

        a.footer__logo.footer__logo--contacts(href="tel:+79000000000", title="Позвонить по номеру телефона")
          .footer__logo-icon
            +svg('telephone', 40, 40)
          span.footer__title +7 (900) 000-00-00

        a.footer__logo.footer__logo--contacts(href="mailto:info@example.ru", title="Написать электронное письмо")
          .footer__logo-icon
            +svg('email', 40, 40)
          span.footer__title info@example.ru

      //- Сообщество
      .footer__community
        .footer__section-title НАШЕ СООБЩЕСТВО

        a.footer__logo.footer__logo--group(href="https://t.me/+RlClLH93pmBjMDIy" target="_blank" rel="noopener")
          .footer__logo-icon
            +svg('telegram', 40, 40)
          span.footer__title Наш Телеграм-канал
