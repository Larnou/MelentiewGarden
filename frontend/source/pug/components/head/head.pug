//- Используемые переменные, относящиеся к Head
    title       - заголовок страницы, указывается на вкладке  /   title   \
    description - описание страницы, используется для SEO

mixin head(title, description)
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no")
    meta(name="format-detection" content="telephone=no")

    title= title
    meta(name="description" content= description)
    link(rel="stylesheet" href="css/style.css")

    // Фавиконки и PWA-иконки
    link(rel="apple-touch-icon" sizes="120x120" href="img/icons/apple-touch-icon.png")
    link(rel="icon" type="image/png" sizes="32x32" href="img/icons/favicon-32x32.png")
    link(rel="icon" type="image/png" sizes="16x16" href="img/icons/favicon-16x16.png")
    link(rel="manifest" href="img/icons/site.webmanifest")
    link(rel="shortcut icon" href="img/icons/favicon.ico")
    meta(name="msapplication-TileColor" content="#ffffff")
    meta(name="msapplication-config" content="img/icons/browserconfig.xml")
    meta(name="theme-color" content="#ffffff")

    //- Для подключения AOS раскомментировать следующую строчку
    //link(href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet")
