extends ../components/template_layout

append variables
  -
    pageTitle = 'Подготовка малины к зиме'
    pageDescription = 'Крупноплодная малина в Сибири: пригибание и укрытие, почему вымерзают почки, ошибка с картоном, сорт «Жёлтый гигант» и снег.'
    main = { class: 'main--article' }

prepend mainContent

  section.article
    .article__container
      a.article__back(href="articles.html") ← Назад к статьям

      h1.article__title Подготовка малины к зиме

      p.article__meta Пригибание, укрытие и зимостойкость крупноплодных сортов

      +articleBlockText()
        p
          | Крупноплодная малина (например, сорта «Краса России», «Гордость России», «Сиреневый туман»)
          |  требует обязательного пригибания на зиму, потому что подобные сорта выведены в Москве и менее
          |  устойчивы к сибирским морозам.

      +articleBlockSliderCaptions()
        .article-block__slide.swiper-slide
          img(src='img/pages/articles/podgotovka-maliny-k-zime/podgotovka.jpg' alt="Подготовка малины к зиме")
          p.article-block__slide-caption Подготовка малины к зиме

      +articleBlockHeadingText('Почему это важно')
        p
          | Если не пригнуть и не укрыть, то весной куст может выглядеть живым (листья зелёные), но ягод
          |  почти не будет — вымерзают плодовые почки.

      +articleBlockHeadingText('Ошибка при укрытии')
        p
          | Нельзя накрывать картоном (от коробок): он намокает, вызывает гниль и плесень.

      +articleBlockHeadingText('Сорт «Жёлтый гигант»')
        p
          | Сорт «Жёлтый гигант» более зимостоек, но и его в Иркутской области пригибают, хоть и без
          |  дополнительного укрытия. Этого достаточно при хорошем снежном покрове. Если снега мало —
          |  можно дополнительно набросить укрывной материал.


